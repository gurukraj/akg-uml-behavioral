+package consign.mq;
+
+import edu.fudan.common.entity.OrderCreatedEvent;
+import edu.fudan.common.util.JsonUtils;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.amqp.core.Binding;
+import org.springframework.amqp.core.BindingBuilder;
+import org.springframework.amqp.core.FanoutExchange;
+import org.springframework.amqp.core.Queue;
+import org.springframework.amqp.rabbit.annotation.RabbitListener;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.http.HttpHeaders;
+import consign.service.ConsignService;
+
+/**
+ * Consumes OrderCreated events published by ts-preserve-service and executes the
+ * consignment step asynchronously (previously a synchronous call from ts-preserve-service).
+ */
+@Configuration
+public class OrderCreatedListener {
+
+    public static final String QUEUE = "order-events.consign";
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(OrderCreatedListener.class);
+
+    @Autowired
+    private ConsignService consignService;
+
+    @Bean
+    public FanoutExchange orderEventsExchange() {
+        return new FanoutExchange(OrderCreatedEvent.EXCHANGE);
+    }
+
+    @Bean
+    public Queue orderCreatedConsignQueue() {
+        return new Queue(QUEUE, true);
+    }
+
+    @Bean
+    public Binding orderCreatedConsignBinding(Queue orderCreatedConsignQueue, FanoutExchange orderEventsExchange) {
+        return BindingBuilder.bind(orderCreatedConsignQueue).to(orderEventsExchange);
+    }
+
+    @RabbitListener(queues = QUEUE)
+    public void onOrderCreated(String message) {
+        OrderCreatedEvent event = JsonUtils.json2Object(message, OrderCreatedEvent.class);
+        if (event == null || !(event.getConsign() != null)) {
+            return;
+        }
+        HttpHeaders headers = new HttpHeaders();
+        if (event.getAuthorization() != null) {
+            headers.set(HttpHeaders.AUTHORIZATION, event.getAuthorization());
+        }
+        LOGGER.info("[onOrderCreated][consignment][OrderId: {}]", event.getOrderId());
+        consignService.insertConsignRecord(JsonUtils.conveterObject(event.getConsign(), consign.entity.Consign.class), headers);
+    }
+}
