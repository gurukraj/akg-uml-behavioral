+package edu.fudan.common.entity;
+
+import lombok.AllArgsConstructor;
+import lombok.Data;
+import lombok.NoArgsConstructor;
+
+/**
+ * Event published by ts-preserve-service after an order has been created.
+ * It carries the optional post-booking requests (assurance, food, consignment),
+ * which are processed asynchronously by the services that own them.
+ */
+@Data
+@NoArgsConstructor
+@AllArgsConstructor
+public class OrderCreatedEvent {
+
+    /** Fan-out exchange on which the event is published. */
+    public static final String EXCHANGE = "order-events";
+
+    private String orderId;
+
+    private String accountId;
+
+    /** Assurance type index; 0 means that no assurance was requested. */
+    private int assuranceType;
+
+    /** Food order; null means that no food was requested. */
+    private FoodOrder foodOrder;
+
+    /** Consignment; null means that no consignment was requested. */
+    private Consign consign;
+
+    /** Authorization header of the original request, propagated to the asynchronous consumers. */
+    private String authorization;
+}
