+package edu.fudan.common.entity;
+
+import lombok.AllArgsConstructor;
+import lombok.Data;
+import lombok.NoArgsConstructor;
+
+/**
+ * Event published by ts-station-service whenever a station is created, updated, or deleted,
+ * so that consumers can maintain a local copy of the station reference data.
+ */
+@Data
+@NoArgsConstructor
+@AllArgsConstructor
+public class StationChangedEvent {
+
+    /** Fan-out exchange on which the event is published. */
+    public static final String EXCHANGE = "station-events";
+
+    public static final String UPSERT = "UPSERT";
+
+    public static final String DELETE = "DELETE";
+
+    private String operation;
+
+    private String stationId;
+
+    private String stationName;
+}
