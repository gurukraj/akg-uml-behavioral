+package preserve.mq;
+
+import edu.fudan.common.entity.OrderCreatedEvent;
+import edu.fudan.common.util.JsonUtils;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.amqp.core.AmqpTemplate;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.stereotype.Component;
+
+/**
+ * Publishes OrderCreated events to the order-events fan-out exchange.
+ */
+@Component
+public class OrderEventPublisher {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(OrderEventPublisher.class);
+
+    @Autowired
+    private AmqpTemplate rabbitTemplate;
+
+    public void publishOrderCreated(OrderCreatedEvent event) {
+        String json = JsonUtils.object2Json(event);
+        rabbitTemplate.convertAndSend(OrderCreatedEvent.EXCHANGE, "", json);
+        LOGGER.info("[publishOrderCreated][OrderId: {}]", event.getOrderId());
+    }
+}
