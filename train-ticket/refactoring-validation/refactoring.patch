@@ -0,0 +1,134 @@
+package fdse.microservice.cache;
+
+import edu.fudan.common.entity.Station;
+import edu.fudan.common.entity.StationChangedEvent;
+import edu.fudan.common.util.JsonUtils;
+import edu.fudan.common.util.Response;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.amqp.core.AnonymousQueue;
+import org.springframework.amqp.core.Binding;
+import org.springframework.amqp.core.BindingBuilder;
+import org.springframework.amqp.core.FanoutExchange;
+import org.springframework.amqp.core.Queue;
+import org.springframework.amqp.rabbit.annotation.RabbitListener;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.context.event.ApplicationReadyEvent;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.event.EventListener;
+import org.springframework.core.ParameterizedTypeReference;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.client.RestTemplate;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Local, event-updated copy of the station reference data (name -> id).
+ *
+ * The copy is loaded once from ts-station-service at start-up (or lazily on first use if the
+ * service was not reachable at start-up) and is afterwards kept current through the
+ * station-events exchange. Request processing in ts-basic-service therefore no longer calls
+ * ts-station-service.
+ */
+@Configuration
+public class StationReferenceCache {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(StationReferenceCache.class);
+
+    private final Map<String, String> idByName = new ConcurrentHashMap<>();
+
+    private final Map<String, String> nameById = new ConcurrentHashMap<>();
+
+    private volatile boolean loaded = false;
+
+    @Autowired
+    private RestTemplate restTemplate;
+
+    @Bean
+    public FanoutExchange stationEventsExchange() {
+        return new FanoutExchange(StationChangedEvent.EXCHANGE);
+    }
+
+    @Bean
+    public Queue basicStationEventsQueue() {
+        return new AnonymousQueue();
+    }
+
+    @Bean
+    public Binding basicStationEventsBinding(Queue basicStationEventsQueue, FanoutExchange stationEventsExchange) {
+        return BindingBuilder.bind(basicStationEventsQueue).to(stationEventsExchange);
+    }
+
+    @EventListener(ApplicationReadyEvent.class)
+    public void loadOnStartup() {
+        load();
+    }
+
+    /** Loads the complete station list from ts-station-service (start-up / cold-start path only). */
+    public synchronized boolean load() {
+        try {
+            ResponseEntity<Response<List<Station>>> re = restTemplate.exchange(
+                    "http://ts-station-service/api/v1/stationservice/stations",
+                    HttpMethod.GET, new HttpEntity<>(null),
+                    new ParameterizedTypeReference<Response<List<Station>>>() {
+                    });
+            Response<List<Station>> body = re.getBody();
+            if (body != null && body.getData() != null) {
+                for (Station s : body.getData()) {
+                    put(s.getId(), s.getName());
+                }
+            }
+            loaded = true;
+            LOGGER.info("[load][Station reference data loaded][stations: {}]", idByName.size());
+        } catch (Exception e) {
+            LOGGER.warn("[load][Station reference data not loaded yet][{}]", e.getMessage());
+        }
+        return loaded;
+    }
+
+    @RabbitListener(queues = "#{basicStationEventsQueue.name}")
+    public void onStationChanged(String message) {
+        StationChangedEvent event = JsonUtils.json2Object(message, StationChangedEvent.class);
+        if (event == null) {
+            return;
+        }
+        if (StationChangedEvent.DELETE.equals(event.getOperation())) {
+            String name = nameById.remove(event.getStationId());
+            if (name != null) {
+                idByName.remove(name);
+            }
+        } else {
+            put(event.getStationId(), event.getStationName());
+        }
+        LOGGER.info("[onStationChanged][{}][stationId: {}, stationName: {}]", event.getOperation(), event.getStationId(), event.getStationName());
+    }
+
+    private void put(String id, String name) {
+        String oldName = nameById.put(id, name);
+        if (oldName != null && !oldName.equals(name)) {
+            idByName.remove(oldName);
+        }
+        idByName.put(name, id);
+    }
+
+    private void ensureLoaded() {
+        if (!loaded) {
+            load();
+        }
+    }
+
+    public Optional<String> idOf(String stationName) {
+        ensureLoaded();
+        return Optional.ofNullable(stationName == null ? null : idByName.get(stationName));
+    }
+
+    public boolean exists(String stationName) {
+        return idOf(stationName).isPresent();
+    }
+}
