--- /dev/null
+++ b/ts-station-service/src/main/java/fdse/microservice/mq/StationEventPublisher.java
@@ -0,0 +1,35 @@
+package fdse.microservice.mq;
+
+import edu.fudan.common.entity.StationChangedEvent;
+import edu.fudan.common.util.JsonUtils;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.amqp.core.AmqpTemplate;
+import org.springframework.amqp.core.FanoutExchange;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+
+/**
+ * Publishes station changes so that consumers (ts-basic-service) can keep a local copy of the
+ * station reference data instead of querying ts-station-service on every request.
+ */
+@Configuration
+public class StationEventPublisher {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(StationEventPublisher.class);
+
+    @Autowired
+    private AmqpTemplate rabbitTemplate;
+
+    @Bean
+    public FanoutExchange stationEventsExchange() {
+        return new FanoutExchange(StationChangedEvent.EXCHANGE);
+    }
+
+    public void publish(String operation, String stationId, String stationName) {
+        StationChangedEvent event = new StationChangedEvent(operation, stationId, stationName);
+        rabbitTemplate.convertAndSend(StationChangedEvent.EXCHANGE, "", JsonUtils.object2Json(event));
+        LOGGER.info("[publish][{}][stationId: {}, stationName: {}]", operation, stationId, stationName);
+    }
+}
